{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-sdlc.local/schemas/agent-capabilities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "model_selection",
    "reasoning_selection",
    "models"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model_selection": {
      "type": "boolean"
    },
    "reasoning_selection": {
      "type": "boolean"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reasoning_efforts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          },
          "reasoning_efforts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            }
          },
          "default_reasoning_effort": {
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          }
        }
      }
    },
    "omitted_reasoning_effort": {
      "enum": [
        "model-default",
        "inherit-parent",
        "unknown"
      ]
    },
    "parent_reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    }
  }
}
