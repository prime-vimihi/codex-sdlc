{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "producer",
    "revision",
    "reviewed_specification",
    "results",
    "defects",
    "recommendation",
    "collector_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
    },
    "task_id": {
      "const": "QC-001"
    },
    "producer": {
      "const": "qc"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reviewed_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification_revision",
        "specification_sha256",
        "facts_sha256",
        "semantic_claims_sha256",
        "acceptance_criteria_sha256"
      ],
      "properties": {
        "specification_revision": {
          "type": "integer",
          "minimum": 1
        },
        "specification_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "facts_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "semantic_claims_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acceptance_criteria_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ac_id",
          "status",
          "evidence",
          "notes"
        ],
        "properties": {
          "ac_id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_tested"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "reference",
                "sha256"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "command",
                    "api",
                    "ui",
                    "live_database",
                    "observation"
                  ]
                },
                "reference": {
                  "type": "string",
                  "format": "portable-repository-path"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "defects": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ac_ids",
          "status",
          "severity",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEF-[A-Z0-9-]+$"
          },
          "ac_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]+$"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "summary": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "recommendation": {
      "enum": [
        "ready",
        "changes_requested"
      ]
    },
    "collector_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "sha256",
          "status"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^evidence/commands/EVD-[0-9a-f]{16}(?:-(?:[2-9]|[1-9][0-9]+))?/evidence\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-sdlc.local/schemas/compact-qc.schema.json",
  "title": "Compact independent verification"
}
