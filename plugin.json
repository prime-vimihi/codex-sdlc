{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-sdlc",
  "version": "0.4.0",
  "description": "Run evidence-backed software delivery across one or more repositories with Codex.",
  "author": {
    "name": "vimihi",
    "url": "https://github.com/prime-vimihi/codex-sdlc"
  },
  "homepage": "https://github.com/prime-vimihi/codex-sdlc#readme",
  "repository": "https://github.com/prime-vimihi/codex-sdlc",
  "license": "Apache-2.0",
  "keywords": ["sdlc", "software-delivery", "multi-repository", "requirements", "quality-assurance"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "codex-sdlc",
        "shortDescription": "Evidence-backed delivery across repositories",
        "longDescription": "Initialize and coordinate resumable software delivery across one repository or mapped Git checkouts through product analysis, implementation, integration, independent quality control, and Product Owner review.",
        "developerName": "vimihi",
        "category": "Productivity",
        "capabilities": ["Read", "Write"],
        "websiteURL": "https://github.com/prime-vimihi/codex-sdlc",
        "privacyPolicyURL": "https://github.com/prime-vimihi/codex-sdlc/blob/main/docs/privacy.md",
        "termsOfServiceURL": "https://github.com/prime-vimihi/codex-sdlc/blob/main/docs/terms.md",
        "defaultPrompt": [
          "Initialize codex-sdlc for this repository.",
          "Configure codex-sdlc across these backend, web, and mobile repositories.",
          "Start or resume a codex-sdlc feature delivery with independent quality control."
        ],
        "brandColor": "#46D7A7",
        "composerIcon": "./assets/brand/codex-sdlc.svg",
        "logo": "./assets/brand/codex-sdlc.svg"
      }
    }
  }
}
